{
  "version": "1.0.0",
  "framework": "django-drf",
  "agents": [
    {
      "agent": "django-solution-architect",
      "purpose": "Design the backend boundary and root-level domain app map from the PRD and discovered target state.",
      "writes_application_code": false,
      "outputs": ["backend architecture decision", "domain map", "task contracts"]
    },
    {
      "agent": "drf-backend-implementer",
      "purpose": "Implement dependency-safe backend vertical slices inside the target monorepo.",
      "writes_application_code": true,
      "allowed_target_paths": ["apps/backend/**", "docs/api/**", ".ai/evidence/**"],
      "maximum_retries_per_failure": 2
    },
    {
      "agent": "django-independent-verifier",
      "purpose": "Independently verify Django checks, migrations, API contracts, tests, security, and scope.",
      "writes_application_code": false,
      "allowed_target_paths": [".ai/evidence/**", "artifacts/**"]
    }
  ]
}
