{
  "version": "1.0.0",
  "framework": "django-drf",
  "target_root": "apps/backend",
  "required_paths": [
    "manage.py",
    "pyproject.toml",
    ".env.example",
    "Dockerfile",
    "README.md",
    "core/settings/base.py",
    "core/settings/local.py",
    "core/settings/test.py",
    "core/settings/production.py",
    "core/settings/database.py",
    "core/urls.py",
    "core/api.py",
    "core/asgi.py",
    "core/wsgi.py",
    "common/health.py",
    "common/models.py",
    "common/pagination.py",
    "common/database/health.py",
    "static",
    "media",
    "scripts/validate_project.py",
    "scripts/check_database.py",
    "scripts/check_migration_plan.py",
    "scripts/check_query_plans.py",
    "scripts/check_openapi_drift.py"
  ],
  "required_directories": ["static", "media"],
  "domain_path_pattern": "<domain>",
  "required_domain_paths": [
    "models.py",
    "services.py",
    "selectors.py",
    "serializers/__init__.py",
    "serializers/input.py",
    "serializers/output.py",
    "views.py",
    "urls.py",
    "filters.py",
    "permissions.py",
    "admin.py",
    "migrations/__init__.py",
    "tests/__init__.py",
    "tests/test_models.py",
    "tests/test_services.py",
    "tests/test_selectors.py",
    "tests/test_serializers.py",
    "tests/test_api.py",
    "tests/test_queries.py"
  ],
  "required_domain_directories": ["migrations", "serializers", "tests"],
  "minimum_domain_instances": 1,
  "domain_excluded_paths": ["core", "common", "static", "media", "scripts"],
  "forbidden_patterns": [
    "business logic in core/settings/**",
    "substantial business logic in views.py",
    "business transaction or database mutation in serializers/**",
    "unbounded or client-controlled queryset ordering",
    "SQLite fallback in generated settings",
    "production table creation outside Django migrations",
    "destructive migration without approval",
    "real secrets in environment files"
  ]
}
