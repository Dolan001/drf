{
  "version": "1.3.0",
  "framework": "django-drf",
  "target_root": "apps/backend",
  "required_paths": [
    "manage.py",
    "pyproject.toml",
    ".env.example",
    ".gitignore",
    ".dockerignore",
    "Dockerfile",
    "README.md",
    "core/__init__.py",
    "core/settings/base.py",
    "core/settings/local.py",
    "core/settings/test.py",
    "core/settings/production.py",
    "core/settings/database.py",
    "core/urls.py",
    "core/api.py",
    "core/exceptions.py",
    "core/logging.py",
    "core/asgi.py",
    "core/wsgi.py",
    "core/settings/__init__.py",
    "common/__init__.py",
    "common/models.py",
    "common/pagination.py",
    "common/database/__init__.py",
    "common/database/health.py",
    "scripts/validate_project.py",
    "scripts/check_database.py",
    "scripts/check_migration_plan.py",
    "scripts/check_query_plans.py",
    "scripts/check_openapi_drift.py"
  ],
  "required_directories": [],
  "required_path_sets": [
    {
      "name": "dependency-lock",
      "alternatives": [
        ["uv.lock"],
        ["poetry.lock"],
        ["pdm.lock"],
        ["requirements.lock", "requirements-dev.lock"]
      ]
    }
  ],
  "conditional_path_groups": [
    {
      "name": "background-tasks",
      "trigger_globs": ["core/celery.py", "*/tasks.py"],
      "required_paths": [
        "core/celery.py",
        "core/settings/tasks.py",
        "scripts/check_workers.py",
        "compose.yaml"
      ],
      "required_directories": [],
      "required_source_patterns": [
        {
          "id": "celery-redis-dependency",
          "globs": ["pyproject.toml"],
          "pattern": "celery\\[redis\\]",
          "ignore_case": true,
          "message": "Background work requires the Celery Redis dependency extra in pyproject.toml."
        },
        {
          "id": "redis-broker-environment",
          "globs": [".env.example"],
          "pattern": "^CELERY_BROKER_URL=redis://",
          "ignore_case": false,
          "message": "The example environment must declare a Redis Celery broker URL."
        },
        {
          "id": "celery-application",
          "globs": ["core/celery.py"],
          "pattern": "Celery\\s*\\(",
          "ignore_case": false,
          "message": "core/celery.py must create the Celery application."
        },
        {
          "id": "django-task-discovery",
          "globs": ["core/celery.py"],
          "pattern": "autodiscover_tasks\\s*\\(",
          "ignore_case": false,
          "message": "The Django Celery application must autodiscover domain tasks."
        },
        {
          "id": "django-broker-setting",
          "globs": ["core/settings/tasks.py"],
          "pattern": "CELERY_BROKER_URL",
          "ignore_case": false,
          "message": "Django task settings must bind the validated Celery broker URL."
        },
        {
          "id": "redis-compose-service",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*redis:\\s*(?:#.*)?$",
          "ignore_case": false,
          "message": "The backend compose file must define a Redis service."
        },
        {
          "id": "redis-compose-image",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*image:\\s*redis(?::|@)",
          "ignore_case": true,
          "message": "The Redis compose service must use an explicitly versioned Redis image."
        },
        {
          "id": "worker-compose-service",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*worker:\\s*(?:#.*)?$",
          "ignore_case": false,
          "message": "The backend compose file must define a Celery worker service."
        },
        {
          "id": "worker-compose-command",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "celery[^\\n]*\\bworker\\b",
          "ignore_case": true,
          "message": "The worker compose service must start a Celery worker process."
        }
      ]
    },
    {
      "name": "realtime",
      "trigger_globs": ["core/routing.py", "*/consumers.py"],
      "required_paths": ["core/routing.py", "core/settings/realtime.py", "scripts/check_realtime.py", "compose.yaml"],
      "required_directories": [],
      "required_source_patterns": [
        {"id": "channels-dependency", "globs": ["pyproject.toml"], "pattern": "channels", "ignore_case": true, "message": "Realtime Django requires Channels."},
        {"id": "channels-redis-dependency", "globs": ["pyproject.toml"], "pattern": "channels-redis", "ignore_case": true, "message": "Multi-process realtime Django requires channels-redis."},
        {"id": "redis-channel-layer", "globs": ["core/settings/realtime.py"], "pattern": "channels_redis\\.core\\.RedisChannelLayer", "ignore_case": false, "message": "Production realtime must use the Redis channel layer."},
        {"id": "redis-realtime-environment", "globs": [".env.example"], "pattern": "^REALTIME_REDIS_URL=redis", "ignore_case": false, "message": "The example environment must declare the realtime Redis URL."},
        {"id": "asgi-websocket-router", "globs": ["core/asgi.py", "core/routing.py"], "pattern": "ProtocolTypeRouter", "ignore_case": false, "message": "Django realtime requires an ASGI protocol router."},
        {"id": "redis-compose-service-realtime", "globs": ["compose.yaml", "compose.yml"], "pattern": "^\\s*redis:\\s*(?:#.*)?$", "ignore_case": false, "message": "Realtime compose must define Redis."}
      ]
    }
  ],
  "domain_path_pattern": "<domain>",
  "module_path_pattern": "<module>",
  "module_naming": {
    "style": "snake_case",
    "ambiguous_names": ["identity", "work", "operations", "data", "management", "collaboration"],
    "familiar_fallback_names": ["accounts", "authentication", "users", "notifications", "articles", "blog", "posts", "tasks", "todos", "webhooks", "chat", "files", "attachments", "payments", "orders", "products", "reports"],
    "responsibility_packages": [
      {"path": "serializers", "trigger_paths": ["serializers"], "minimum_modules": 1, "forbidden_module_names": ["input.py", "output.py", "serializers.py"], "extensions": [".py"]},
      {"path": "views", "trigger_paths": ["views", "urls.py", "serializers"], "minimum_modules": 1, "forbidden_module_names": ["views.py"], "extensions": [".py"]}
    ],
    "max_lines": [
      {"globs": ["models.py", "services.py", "selectors.py", "permissions.py", "tasks.py", "consumers.py", "serializers/*.py", "views/*.py"], "maximum": 300}
    ]
  },
  "required_domain_paths": [
    "__init__.py",
    "apps.py",
    "models.py",
    "services.py",
    "migrations/__init__.py",
    "tests/__init__.py",
    "tests/test_models.py",
    "tests/test_services.py"
  ],
  "required_domain_directories": ["migrations", "tests"],
  "conditional_domain_groups": [
    {
      "name": "optimized-reads",
      "trigger_paths": ["selectors.py"],
      "required_paths": ["selectors.py", "tests/test_selectors.py", "tests/test_queries.py"],
      "required_directories": []
    },
    {
      "name": "rest-api",
      "trigger_paths": ["views", "urls.py", "serializers"],
      "required_paths": [
        "serializers",
        "serializers/__init__.py",
        "views",
        "views/__init__.py",
        "urls.py",
        "permissions.py",
        "tests/test_serializers.py",
        "tests/test_api.py"
      ],
      "required_directories": ["serializers", "views"]
    },
    {
      "name": "background-tasks",
      "trigger_paths": ["tasks.py"],
      "required_paths": ["tasks.py", "outbox.py", "tests/test_tasks.py", "tests/test_outbox.py"],
      "required_directories": []
    },
    {
      "name": "realtime",
      "trigger_paths": ["consumers.py", "routing.py"],
      "required_paths": [
        "consumers.py",
        "routing.py",
        "events.py",
        "tests/test_realtime.py",
        "tests/test_realtime_auth.py"
      ],
      "required_directories": []
    }
  ],
  "minimum_domain_instances": 1,
  "domain_excluded_paths": ["core", "common", "static", "media", "scripts"],
  "source_rules": [
    {
      "id": "no-sqlite-runtime",
      "globs": ["core/settings/**/*.py"],
      "pattern": "django\\.db\\.backends\\.sqlite3|sqlite(?:\\+[a-z0-9_]+)?://|\\.sqlite3?\\b",
      "ignore_case": true,
      "scan_strings": true,
      "message": "Django runtime settings must use PostgreSQL without a SQLite fallback."
    },
    {
      "id": "schema-changes-use-migrations",
      "globs": [
        "core/**/*.py",
        "common/**/*.py",
        "*/models.py",
        "*/services.py",
        "*/views/*.py",
        "*/serializers/*.py"
      ],
      "pattern": "(?:schema_editor\\.(?:create_model|delete_model|execute)|CREATE\\s+TABLE|ALTER\\s+TABLE|DROP\\s+TABLE)",
      "ignore_case": true,
      "scan_strings": true,
      "message": "Production schema changes must be expressed through reviewed Django migrations."
    },
    {
      "id": "views-do-not-persist-directly",
      "globs": ["*/views/*.py"],
      "pattern": "(?:transaction\\.atomic|\\.objects\\.|\\.(?:save|delete|bulk_create|bulk_update)\\s*\\()",
      "ignore_case": false,
      "message": "DRF views orchestrate HTTP and must delegate database writes to services."
    },
    {
      "id": "serializers-do-not-import-services",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "(?:from\\s+[.a-zA-Z0-9_]*services?\\s+import|import\\s+[.a-zA-Z0-9_]*services?\\b)",
      "ignore_case": false,
      "message": "DRF serializers validate and serialize only; views call write services."
    },
    {
      "id": "serializers-do-not-mutate-database",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "(?:transaction\\.atomic|\\.objects\\.|\\.(?:save|delete|bulk_create|bulk_update)\\s*\\()",
      "ignore_case": false,
      "message": "DRF serializers must not own database writes or transactions."
    },
    {
      "id": "serializers-explicit-public-fields",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "fields\\s*=\\s*[\\\"']__all__[\\\"']",
      "ignore_case": false,
      "scan_strings": true,
      "message": "Public DRF serializers must declare fields explicitly."
    },
    {
      "id": "ordering-fields-are-whitelisted",
      "globs": ["**/*.py"],
      "pattern": "ordering_fields\\s*=\\s*[\\\"']__all__[\\\"']",
      "ignore_case": false,
      "scan_strings": true,
      "message": "DRF ordering fields must be explicitly whitelisted."
    }
  ]
}
