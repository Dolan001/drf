{
  "version": "1.1.0",
  "framework": "django-drf",
  "target_root": "apps/backend",
  "required_paths": [
    "manage.py",
    "pyproject.toml",
    ".env.example",
    ".gitignore",
    ".dockerignore",
    "Dockerfile",
    "README.md",
    "core/__init__.py",
    "core/settings/base.py",
    "core/settings/local.py",
    "core/settings/test.py",
    "core/settings/production.py",
    "core/settings/database.py",
    "core/urls.py",
    "core/api.py",
    "core/exceptions.py",
    "core/logging.py",
    "core/asgi.py",
    "core/wsgi.py",
    "core/settings/__init__.py",
    "common/__init__.py",
    "common/models.py",
    "common/pagination.py",
    "common/database/__init__.py",
    "common/database/health.py",
    "scripts/validate_project.py",
    "scripts/check_database.py",
    "scripts/check_migration_plan.py",
    "scripts/check_query_plans.py",
    "scripts/check_openapi_drift.py"
  ],
  "required_directories": [],
  "required_path_sets": [
    {
      "name": "dependency-lock",
      "alternatives": [
        ["uv.lock"],
        ["poetry.lock"],
        ["pdm.lock"],
        ["requirements.lock", "requirements-dev.lock"]
      ]
    }
  ],
  "domain_path_pattern": "<domain>",
  "required_domain_paths": [
    "__init__.py",
    "apps.py",
    "models.py",
    "services.py",
    "migrations/__init__.py",
    "tests/__init__.py",
    "tests/test_models.py",
    "tests/test_services.py"
  ],
  "required_domain_directories": ["migrations", "tests"],
  "conditional_domain_groups": [
    {
      "name": "optimized-reads",
      "trigger_paths": ["selectors.py"],
      "required_paths": ["selectors.py", "tests/test_selectors.py", "tests/test_queries.py"],
      "required_directories": []
    },
    {
      "name": "rest-api",
      "trigger_paths": ["views.py", "urls.py", "serializers"],
      "required_paths": [
        "serializers",
        "serializers/__init__.py",
        "serializers/input.py",
        "serializers/output.py",
        "views.py",
        "urls.py",
        "permissions.py",
        "tests/test_serializers.py",
        "tests/test_api.py"
      ],
      "required_directories": ["serializers"]
    }
  ],
  "minimum_domain_instances": 1,
  "domain_excluded_paths": ["core", "common", "static", "media", "scripts"],
  "source_rules": [
    {
      "id": "no-sqlite-runtime",
      "globs": ["core/settings/**/*.py"],
      "pattern": "django\\.db\\.backends\\.sqlite3|sqlite(?:\\+[a-z0-9_]+)?://|\\.sqlite3?\\b",
      "ignore_case": true,
      "scan_strings": true,
      "message": "Django runtime settings must use PostgreSQL without a SQLite fallback."
    },
    {
      "id": "schema-changes-use-migrations",
      "globs": [
        "core/**/*.py",
        "common/**/*.py",
        "*/models.py",
        "*/services.py",
        "*/views.py",
        "*/serializers/*.py"
      ],
      "pattern": "(?:schema_editor\\.(?:create_model|delete_model|execute)|CREATE\\s+TABLE|ALTER\\s+TABLE|DROP\\s+TABLE)",
      "ignore_case": true,
      "scan_strings": true,
      "message": "Production schema changes must be expressed through reviewed Django migrations."
    },
    {
      "id": "views-do-not-persist-directly",
      "globs": ["*/views.py"],
      "pattern": "(?:transaction\\.atomic|\\.objects\\.|\\.(?:save|delete|bulk_create|bulk_update)\\s*\\()",
      "ignore_case": false,
      "message": "DRF views orchestrate HTTP and must delegate database writes to services."
    },
    {
      "id": "serializers-do-not-import-services",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "(?:from\\s+[.a-zA-Z0-9_]*services?\\s+import|import\\s+[.a-zA-Z0-9_]*services?\\b)",
      "ignore_case": false,
      "message": "DRF serializers validate and serialize only; views call write services."
    },
    {
      "id": "serializers-do-not-mutate-database",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "(?:transaction\\.atomic|\\.objects\\.|\\.(?:save|delete|bulk_create|bulk_update)\\s*\\()",
      "ignore_case": false,
      "message": "DRF serializers must not own database writes or transactions."
    },
    {
      "id": "serializers-explicit-public-fields",
      "globs": ["*/serializers/*.py", "*/serializers/**/*.py"],
      "pattern": "fields\\s*=\\s*[\\\"']__all__[\\\"']",
      "ignore_case": false,
      "scan_strings": true,
      "message": "Public DRF serializers must declare fields explicitly."
    },
    {
      "id": "ordering-fields-are-whitelisted",
      "globs": ["**/*.py"],
      "pattern": "ordering_fields\\s*=\\s*[\\\"']__all__[\\\"']",
      "ignore_case": false,
      "scan_strings": true,
      "message": "DRF ordering fields must be explicitly whitelisted."
    }
  ]
}
